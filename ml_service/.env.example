# Copy to .env and fill in real values. Never commit .env.
# app/core/config.py validates these at import time and exits with a readable
# report if anything is missing or malformed.

# Shared secret for server-to-server calls from the Node backend.
# Must be at least 16 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The Node backend will read the same value as ML_SERVICE_API_KEY in Step 5.
INTERNAL_API_KEY="replace-me-with-a-long-random-string"

# Port uvicorn binds to.
PORT=8000

ENV=development
