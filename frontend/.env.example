# Frontend build-time configuration.
#
# Development needs none of this: requests go to /api/v1 and vite.config.js
# proxies them to localhost:4000, which keeps the app same-origin.
#
# Production needs the API's origin, because Vercel serves static files only
# and cannot proxy to another host. Set this in the Vercel dashboard.
#
#   VITE_API_URL="https://transactguard-api.onrender.com"
VITE_API_URL=""
