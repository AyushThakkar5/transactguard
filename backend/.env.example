# Copy to .env and fill in real values. Never commit .env.
# config/env.js validates every one of these at startup and exits if any is
# missing or malformed, so a bad value fails loudly instead of at first request.

# --- Database ---------------------------------------------------------------
# Must match the credentials in docker-compose.yml.
DATABASE_URL="postgresql://transactguard:transactguard@localhost:5432/transactguard?schema=public"

# --- Cache / queue backend --------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The two secrets MUST be different — that is what stops a refresh token from
# being replayed as an access token.
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"

# --- ML service (Step 4) ----------------------------------------------------
# The FastAPI fraud scorer. Called server-to-server only.
ML_SERVICE_URL="http://localhost:8000"

# MUST be identical to INTERNAL_API_KEY in ml_service/.env — the two services
# authenticate to each other with this single shared secret.
ML_SERVICE_API_KEY="replace-me-with-the-same-value-as-ml_service-INTERNAL_API_KEY"

# --- Seed accounts ----------------------------------------------------------
# Passwords for the privileged seed accounts. Optional in development (the seed
# falls back to documented values); REQUIRED when NODE_ENV=production, where the
# seed exits rather than create an admin with a guessable password.
ADMIN_SEED_PASSWORD=""
ANALYST_SEED_PASSWORD=""

# --- Worker ------------------------------------------------------------------
# Run the BullMQ consumer inside the API process rather than as its own service.
# Leave false locally and run `npm run worker` in a second terminal — a separate
# process is the better design. Set true only on hosts with no background-worker
# service type (Render's free tier), where it is the only way to drain the queue.
RUN_WORKER_INLINE=false

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
